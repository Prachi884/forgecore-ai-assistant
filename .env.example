# ─── ForgeCore AI Assistant — Environment Template ─────────
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file to git (already in .gitignore).

# ─── LLM Provider ────────────────────────────────────────────
# Google Gemini API — free tier: https://aistudio.google.com/apikey
# Get your key from Google AI Studio (no credit card required).
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model to use (free tier supports these).
# Options: gemini-2.0-flash (fast, recommended), gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# ─── Application ─────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=INFO

# ─── Vector Database ─────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=forgecore_knowledge

# ─── Embeddings ──────────────────────────────────────────────
# Local sentence-transformers model (runs on CPU, no API needed)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
